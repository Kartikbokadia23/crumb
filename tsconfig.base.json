{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@crumb/core": ["packages/core/src/index.ts"],
      "@crumb/storage": ["packages/storage/src/index.ts"],
      "@crumb/splitwise": ["packages/splitwise/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
